@page "/templates"
@implements IDisposable
@inject LocalRepository Repository
@inject SyncEngine Engine
@inject NavigationManager Navigation
@inject ILogger<TemplatesPage> Logger

<PageTitle>@L["App.Title"]</PageTitle>

<a href="settings" class="mb-1 inline-flex items-center gap-1 rounded-lg py-2 pr-2 text-sm text-blue-700 hover:underline dark:text-blue-300">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    @L["Settings.Heading"]
</a>
<h1 class="text-xl font-semibold">@L["Templates.Heading"]</h1>
<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">@L["Templates.Help"]</p>

<button type="button" @onclick="CreateAsync" disabled="@creating" data-testid="new-template"
        class="mt-4 w-full rounded-xl border-2 border-dashed border-blue-300 px-4 py-4 font-medium text-blue-700 hover:bg-blue-50 focus-visible:outline-2 focus-visible:outline-blue-500 disabled:opacity-60 dark:border-blue-800 dark:text-blue-300 dark:hover:bg-blue-950">
    @(creating ? L["Common.Loading"] : "+ " + L["Templates.New"])
</button>

@if (error is not null)
{
    <p class="mt-3 text-sm text-red-600 dark:text-red-400" role="alert">@error</p>
}

@if (templates is null)
{
    <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">@L["Common.Loading"]</p>
}
else if (templates.Count == 0)
{
    <div class="mt-4 flex flex-col items-center gap-3 rounded-xl border border-dashed border-gray-300 px-4 py-10 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400" data-testid="templates-empty">
        <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h3" /></svg>
        <p>@L["Next.NoTemplates"]</p>
    </div>
}
else
{
    <ul class="mt-4 flex flex-col gap-2" data-testid="templates">
        @foreach (var template in templates)
        {
            <li @key="template.Id">
                <a href="templates/@template.Id" class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-3 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-blue-500 dark:border-gray-800 dark:bg-gray-900 dark:hover:bg-gray-800">
                    <PlanIcon Slug="@ExerciseCategories.IconFor(new Workout { Id = template.Id, Date = default, Exercises = template.Exercises }, exercises)" />
                    <span class="min-w-0 flex-1">
                        <span class="block truncate font-semibold">@template.Name</span>
                        <span class="block truncate text-sm text-gray-500 dark:text-gray-400">
                            @string.Join(", ", template.Exercises.Select(e => exercises.GetValueOrDefault(e.ExerciseId)?.Name ?? L["Exercise.Unknown"]))
                        </span>
                    </span>
                    <svg class="size-5 shrink-0 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </a>
            </li>
        }
    </ul>
}

@code {
    private List<WorkoutTemplate>? templates;
    private Dictionary<Guid, Exercise> exercises = [];
    private string? error;
    private bool creating;

    protected override async Task OnInitializedAsync()
    {
        Engine.DataChanged += OnRemoteChange;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            exercises = (await Repository.GetAllAsync<Exercise>()).ToDictionary(e => e.Id);
            templates = [.. (await Repository.GetAllAsync<WorkoutTemplate>()).OrderBy(t => t.Name, StringComparer.CurrentCultureIgnoreCase)];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not read templates");
            templates = [];
            error = L["Home.LoadFailed"];
        }
    }

    /// <summary>An empty template named "Ny mall", opened at once to add exercises and a name.</summary>
    private async Task CreateAsync()
    {
        if (creating)
            return;
        creating = true;
        try
        {
            var template = new WorkoutTemplate { Id = Guid.NewGuid(), Name = L["Templates.New"] };
            await Repository.SaveAsync(template.Id, template);
            Navigation.NavigateTo($"templates/{template.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not create template");
            error = L["Home.SaveFailed"];
        }
        finally
        {
            creating = false;
        }
    }

    private void OnRemoteChange() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Engine.DataChanged -= OnRemoteChange;
}
