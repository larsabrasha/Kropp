<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- Off: the placeholders (#[.{fingerprint}], the import map, the preload link) are filled in
         when this project is published on its own, but not when Kropp.Api publishes it as a
         referenced project — the shell then names a script that does not exist and the app never
         starts. index.html names the unfingerprinted files instead, which both serve; the
         service worker's asset manifest carries the hashes that make updates reach the phone. -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- Culture data for sv-SE date and number formatting; the default trims it to invariant. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <PropertyGroup Label="Tailwind Properties">
    <TailwindVersion>v4.2.2</TailwindVersion>
    <TailwindConfigDir>$(MSBuildProjectDirectory)</TailwindConfigDir>
    <TailwindInputFile>$(MSBuildProjectDirectory)\tailwind-input.css</TailwindInputFile>
    <TailwindOutputFile>$(MSBuildProjectDirectory)\wwwroot\tailwind-output.css</TailwindOutputFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kropp.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Tailwind.MSBuild">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kropp.Shared\Kropp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same fix as GospelPresenter.Shared: the wwwroot glob is evaluated before Tailwind runs, so on
         a clean checkout the generated stylesheet would be missing from the static web assets. -->
    <Content Include="wwwroot/tailwind-output.css" Condition="!Exists('wwwroot/tailwind-output.css')" />
  </ItemGroup>

  <Target Name="BuildTailwindBeforeStaticWebAssets"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          DependsOnTargets="BuildTailwind"/>

</Project>
