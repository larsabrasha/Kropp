# Copy to .env (gitignored) and fill in. Never commit the real file.

# Any long random string, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=

# Where the API listens for the reverse proxy. A port alone listens on every interface;
# an address and a port (e.g. 192.168.1.10:8080) only on that one.
KROPP_LISTEN=8080

# The image tag: latest (main), or sha-<commit> to pin a version.
KROPP_TAG=latest

# Where the nightly database dumps go, and how many days they are kept. The dumps hold
# health data: prefer a disk other than the database's, e.g. a mounted NAS share.
KROPP_BACKUP_DIR=./backups
KROPP_BACKUP_KEEP_DAYS=30
