@page "/trash"
@implements IDisposable
@inject LocalRepository Repository
@inject WorkoutTrash Trash
@inject SyncEngine Engine
@inject TimeProvider Time
@inject ILogger<TrashPage> Logger

<PageTitle>@L["App.Title"]</PageTitle>

<a href="settings" class="mb-1 inline-flex items-center gap-1 rounded-lg py-2 pr-2 text-sm text-blue-700 hover:underline dark:text-blue-300">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    @L["Settings.Heading"]
</a>
<h1 class="text-xl font-semibold">@L["Trash.Heading"]</h1>
<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">@L["Trash.Help"]</p>

@if (error is not null)
{
    <p class="mt-3 text-sm text-red-600 dark:text-red-400" role="alert">@error</p>
}

@if (trashed is null)
{
    <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">@L["Common.Loading"]</p>
}
else if (trashed.Count == 0)
{
    <div class="mt-4 flex flex-col items-center gap-3 rounded-xl border border-dashed border-gray-300 px-4 py-10 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400" data-testid="trash-empty">
        <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3" /></svg>
        <p>@L["Trash.Empty"]</p>
    </div>
}
else
{
    <ul class="mt-4 flex flex-col gap-2" data-testid="trash">
        @foreach (var item in trashed)
        {
            var workout = item.Workout;
            var name = ExerciseCategories.WorkoutName(workout, exercises, L);
            var busy = busyId == item.Id;
            <li @key="item.Id" class="rounded-xl border border-gray-200 bg-white p-3 dark:border-gray-800 dark:bg-gray-900" data-testid="trashed-workout">
                <span class="block truncate font-semibold" data-testid="trashed-name">@(name ?? workout.Note ?? L["Home.Heading"])</span>
                <span class="block truncate text-sm text-gray-500 dark:text-gray-400">
                    <span class="first-letter:uppercase inline-block">@workout.Date.ToString("dddd d MMM yyyy")</span>
                    <span> · @(workout.Exercises.Count == 1 ? L["Home.ExerciseCountOne"] : L["Home.ExerciseCount", workout.Exercises.Count])</span>
                </span>
                <span class="mt-0.5 block text-sm text-gray-500 dark:text-gray-400" data-testid="deleted-for-good">@DeletedForGoodText(item)</span>

                @if (confirmingId == item.Id)
                {
                    <div class="mt-3 flex flex-wrap items-center gap-2" role="alertdialog" aria-label="@L["Trash.DeleteConfirm"]">
                        <span class="w-full text-sm">@L["Trash.DeleteConfirm"]</span>
                        <button type="button" @onclick="() => DeleteForGoodAsync(item)" disabled="@busy" data-testid="confirm-delete"
                                class="rounded-lg bg-red-600 px-4 py-2.5 font-medium text-white hover:bg-red-700 disabled:opacity-60">
                            @(busy ? L["Common.Loading"] : L["Trash.DeleteNow"])
                        </button>
                        <button type="button" @onclick="() => confirmingId = null" class="rounded-lg px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800">@L["Common.Cancel"]</button>
                    </div>
                }
                else
                {
                    <div class="mt-3 flex items-center gap-2">
                        <button type="button" @onclick="() => confirmingId = item.Id" disabled="@(busyId is not null)" data-testid="delete-now"
                                class="rounded-lg px-3 py-2.5 text-sm font-medium text-red-700 hover:bg-red-50 disabled:opacity-60 dark:text-red-400 dark:hover:bg-red-950">
                            @L["Trash.DeleteNow"]
                        </button>
                        <button type="button" @onclick="() => RestoreAsync(item)" disabled="@(busyId is not null)" data-testid="restore"
                                class="ml-auto rounded-lg bg-accent-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-accent-700 focus-visible:outline-2 focus-visible:outline-blue-500 disabled:opacity-60">
                            @(busy ? L["Common.Loading"] : L["Trash.Restore"])
                        </button>
                    </div>
                }
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<TrashedWorkout>? trashed;
    private Dictionary<Guid, Exercise> exercises = [];
    private Guid? busyId;
    private Guid? confirmingId;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Engine.DataChanged += OnRemoteChange;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            exercises = (await Repository.GetAllAsync<Exercise>()).ToDictionary(e => e.Id);
            trashed = await Trash.PurgeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not read the trash");
            trashed = [];
            error = L["Home.LoadFailed"];
        }
    }

    private string DeletedForGoodText(TrashedWorkout item)
    {
        var days = (int)Math.Ceiling((WorkoutTrash.DeletedForGoodAt(item) - Time.GetUtcNow()).TotalDays);
        return days <= 1 ? L["Trash.DeletedSoon"] : L["Trash.DeletedInDays", days];
    }

    private Task RestoreAsync(TrashedWorkout item) => RunAsync(item, () => Trash.RestoreAsync(item), "Could not restore workout");

    private Task DeleteForGoodAsync(TrashedWorkout item) => RunAsync(item, () => Trash.DeleteForGoodAsync(item.Id), "Could not delete workout for good");

    private async Task RunAsync(TrashedWorkout item, Func<Task> action, string failure)
    {
        if (busyId is not null)
            return;
        busyId = item.Id;
        error = null;
        try
        {
            await action();
            trashed = [.. trashed!.Where(t => t.Id != item.Id)];
            confirmingId = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{Failure}", failure);
            error = L["Home.SaveFailed"];
        }
        finally
        {
            busyId = null;
        }
    }

    private void OnRemoteChange() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Engine.DataChanged -= OnRemoteChange;
}
