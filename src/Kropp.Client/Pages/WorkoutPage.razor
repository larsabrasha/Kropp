@page "/workouts/{Id:guid}"
@implements IDisposable
@inject LocalRepository Repository
@inject SyncEngine Engine
@inject NavigationManager Navigation
@inject ILogger<WorkoutPage> Logger
@inject IJSRuntime JS
@inject TimeProvider Time

<PageTitle>@L["App.Title"]</PageTitle>

<a href="" class="mb-1 inline-flex items-center gap-1 rounded-lg py-2 pr-2 text-sm text-blue-700 hover:underline dark:text-blue-300">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    @L["Workout.Back"]
</a>

@if (!loaded)
{
    <p class="text-sm text-gray-500 dark:text-gray-400">@L["Common.Loading"]</p>
}
else if (workout is null)
{
    <div class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-gray-300 px-4 py-10 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400" data-testid="not-found">
        <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
        <p>@L["Workout.NotFound"]</p>
    </div>
}
else
{
    @* Compact like the exercise cards: date and details as text, opened for editing on a tap. *@
    <div data-testid="details">
        <h1 class="text-xl font-semibold">
            <button type="button" @onclick="ToggleDetails" aria-expanded="@(editingDetails ? "true" : "false")"
                    class="text-left first-letter:uppercase hover:text-gray-600 dark:hover:text-gray-300">@workout.Date.ToString("dddd d MMMM yyyy")</button>
        </h1>
        <button type="button" @onclick="ToggleDetails" aria-expanded="@(editingDetails ? "true" : "false")"
                class="block max-w-full truncate text-left text-sm text-gray-500 underline decoration-gray-300 decoration-dotted underline-offset-4 hover:text-gray-700 dark:text-gray-400 dark:decoration-gray-600 dark:hover:text-gray-200">@DetailsText</button>
    </div>

    @if (editingDetails)
    {
        <section class="mt-2 rounded-lg bg-gray-50 p-2 dark:bg-gray-900" data-testid="details-editor">
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                <label class="flex flex-col gap-1 text-xs text-gray-600 dark:text-gray-400">
                    <span>@L["Home.Date"]</span>
                    <input type="date" value="@workout.Date.ToString("yyyy-MM-dd")" @onchange="ChangeDate"
                           class="rounded-lg border border-gray-300 bg-white px-2 py-2 text-base text-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100" />
                </label>
                <NumberField Label="@L["Workout.SessionNumber"]" Value="@TrainingText.Invariant(workout.SessionNumber)"
                             Changed="v => SaveAsync(workout with { SessionNumber = TrainingText.ParseInt(v) })" />
                <div class="col-span-2 sm:col-span-1">
                    <TextField Label="@L["Home.Note"]" Value="@workout.Note" Changed="v => SaveAsync(workout with { Note = v })" />
                </div>
            </div>
            <DoneRow OnDone="() => editingDetails = false" />
        </section>
    }


    @if (error is not null)
    {
        <p class="mt-3 text-sm text-red-600 dark:text-red-400" role="alert">@error</p>
    }

    <div class="mt-4">
        <ExerciseList Owner="workout" Exercises="exercises" History="workouts" OnChange="SaveAsync" OnExerciseChange="SaveExerciseAsync" />
    </div>

    <section class="mt-8 flex flex-col gap-2 border-t border-gray-200 pt-4 sm:flex-row sm:justify-between dark:border-gray-800">
        <div class="flex flex-col gap-2 sm:flex-row">
            <button type="button" @onclick="CopyAsync" disabled="@busy"
                    class="rounded-lg border border-gray-300 px-4 py-2.5 font-medium hover:bg-gray-100 disabled:opacity-60 dark:border-gray-700 dark:hover:bg-gray-800">
                @L["Workout.CopyAsPlan"]
            </button>
            <button type="button" @onclick="SaveAsTemplateAsync" disabled="@(busy || workout.Exercises.Count == 0)" data-testid="save-template"
                    class="rounded-lg border border-gray-300 px-4 py-2.5 font-medium hover:bg-gray-100 disabled:opacity-60 dark:border-gray-700 dark:hover:bg-gray-800">
                @L["Workout.SaveAsTemplate"]
            </button>
            @if (savedTemplate is not null)
            {
                <p class="self-center text-sm text-green-700 dark:text-green-400" role="status" data-testid="template-saved">@L["Workout.TemplateSaved", savedTemplate]</p>
            }
        </div>
        @if (confirmingDelete)
        {
            <div class="flex items-center gap-2" role="alertdialog" aria-label="@L["Workout.DeleteConfirm"]">
                <span class="text-sm">@L["Workout.DeleteConfirm"]</span>
                <button type="button" @onclick="DeleteAsync" class="rounded-lg bg-red-600 px-4 py-2.5 font-medium text-white hover:bg-red-700">@L["Workout.Delete"]</button>
                <button type="button" @onclick="() => confirmingDelete = false" class="rounded-lg px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800">@L["Common.Cancel"]</button>
            </div>
        }
        else
        {
            <button type="button" @onclick="() => confirmingDelete = true" class="rounded-lg px-4 py-2.5 font-medium text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950">
                @L["Workout.Delete"]
            </button>
        }
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loaded;
    private Workout? workout;
    private List<Workout> workouts = [];
    private Dictionary<Guid, Exercise> exercises = [];
    private bool editingDetails;
    private string? savedTemplate;

    // The workout whose first render has been scrolled to the top. The page is reused when only the
    // id changes ("Kopiera som ny plan" is at the bottom), and a reload lets the browser restore an
    // old position; either way a workout should open at its top.
    private Guid? scrolledFor;


    private void ToggleDetails() => editingDetails = !editingDetails;

    private string DetailsText
    {
        get
        {
            var parts = new List<string>();
            if (workout is not null && ExerciseCategories.WorkoutName(workout, exercises, L) is { } name)
                parts.Add(name);
            if (workout?.SessionNumber is { } number)
                parts.Add(L["Home.SessionShort", number]);
            if (workout is not null)
                parts.Add(L[$"Workout.Status.{WorkoutEditing.StatusOf(workout, Today)}"]);
            if (!string.IsNullOrWhiteSpace(workout?.Note))
                parts.Add(workout.Note);
            return parts.Count > 0 ? string.Join(" · ", parts) : L["Workout.AddDetails"];
        }
    }
    private bool busy;
    private bool confirmingDelete;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Engine.DataChanged += OnRemoteChange;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loaded && workout?.Id != Id)
        {
            editingDetails = false;
            confirmingDelete = false;
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loaded || scrolledFor == Id)
            return;
        scrolledFor = Id;
        _ = PrefetchIllustrationsAsync();
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/kropp-ui.js");
            await module.InvokeVoidAsync("scrollToTop");
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Could not scroll to the top");
        }
    }

    private async Task SaveExerciseAsync(Exercise exercise)
    {
        try
        {
            await Repository.SaveAsync(exercise.Id, exercise);
            exercises[exercise.Id] = exercise;
            await PrefetchIllustrationsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save exercise {Id}", exercise.Id);
            error = L["Home.SaveFailed"];
        }
    }

    // Loads this workout's pictures while there is a network, so the service worker
    // has them when there is none. Only the pictures in use are fetched, never the whole catalog.
    private async Task PrefetchIllustrationsAsync()
    {
        if (workout is null)
            return;
        var urls = workout.Exercises
            .Select(e => ExerciseIllustrations.SlugFor(exercises.GetValueOrDefault(e.ExerciseId)))
            .OfType<string>()
            .Distinct()
            .Select(ExerciseIllustrations.Picture)
            .ToArray();
        if (urls.Length == 0)
            return;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/kropp-ui.js");
            await module.InvokeVoidAsync("prefetch", (object)urls);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Could not prefetch illustrations");
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            workouts = [.. await Repository.GetAllAsync<Workout>()];
            exercises = (await Repository.GetAllAsync<Exercise>()).ToDictionary(e => e.Id);
            workout = workouts.FirstOrDefault(w => w.Id == Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not read workout {Id}", Id);
            error = L["Home.LoadFailed"];
        }
        loaded = true;
    }

    // Saved at once and locally; sync picks it up a few seconds later.
    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    private async Task SaveAsync(Workout next)
    {
        next = WorkoutEditing.WithDerivedStatus(next, Today);
        var exercisesChanged = workout is null || !workout.Exercises.Select(e => e.ExerciseId).ToHashSet().SetEquals(next.Exercises.Select(e => e.ExerciseId));
        var previous = workout;
        workout = next;
        workouts = [.. workouts.Where(w => w.Id != next.Id), next];
        error = null;
        try
        {
            await Repository.SaveAsync(next.Id, next);
            if (exercisesChanged)
                await PrefetchIllustrationsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save workout {Id}", next.Id);
            workout = previous;
            error = L["Home.SaveFailed"];
        }
    }

    private Task ChangeDate(ChangeEventArgs e) =>
        DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", out var date) && workout is not null
            ? SaveAsync(workout with { Date = date })
            : Task.CompletedTask;

    private async Task CopyAsync()
    {
        if (busy || workout is null)
            return;
        busy = true;
        try
        {
            var copy = WorkoutEditing.CopyAsPlan(workout, Guid.NewGuid(), Today, WorkoutEditing.NextSessionNumber(workouts));
            await Repository.SaveAsync(copy.Id, copy);
            Navigation.NavigateTo($"workouts/{copy.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not copy workout");
            error = L["Home.SaveFailed"];
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveAsTemplateAsync()
    {
        if (busy || workout is null)
            return;
        busy = true;
        try
        {
            var name = ExerciseCategories.WorkoutName(workout, exercises, L) ?? workout.Note ?? L["Home.Heading"];
            var template = Planning.TemplateFrom(workout, Guid.NewGuid(), name);
            await Repository.SaveAsync(template.Id, template);
            savedTemplate = name;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save template");
            error = L["Home.SaveFailed"];
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await Repository.DeleteAsync<Workout>(Id);
            Navigation.NavigateTo("");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not delete workout");
            error = L["Home.SaveFailed"];
        }
    }

    private void OnRemoteChange() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Engine.DataChanged -= OnRemoteChange;
}
