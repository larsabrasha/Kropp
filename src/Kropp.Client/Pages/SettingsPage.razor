@page "/settings"
@inject LocalRepository Repository
@inject ILogger<SettingsPage> Logger

<PageTitle>@L["App.Title"]</PageTitle>

<a href="" class="mb-1 inline-flex items-center gap-1 rounded-lg py-2 pr-2 text-sm text-blue-700 hover:underline dark:text-blue-300">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    @L["Workout.Back"]
</a>
<h1 class="text-xl font-semibold">@L["Settings.Heading"]</h1>

@if (settings is null)
{
    <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">@L["Common.Loading"]</p>
}
else
{
    <section class="mt-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
        <h2 class="mb-3 text-base font-semibold">@L["Settings.Planning"]</h2>
        <Stepper Label="@L["Settings.SessionsPerWeek"]" Value="settings.SessionsPerWeek" Min="UserSettings.MinSessionsPerWeek" Max="UserSettings.MaxSessionsPerWeek"
                 Changed="v => SaveAsync(settings with { SessionsPerWeek = (int)Math.Clamp(v ?? UserSettings.Default.SessionsPerWeek, UserSettings.MinSessionsPerWeek, UserSettings.MaxSessionsPerWeek) })" />
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-300" data-testid="settings-effect">
            @(settings.DaysBetweenSessions == 1 ? L["Settings.EffectOneDay"] : L["Settings.Effect", settings.DaysBetweenSessions])
        </p>
        @if (error is not null)
        {
            <p class="mt-3 text-sm text-red-600 dark:text-red-400" role="alert">@error</p>
        }
    </section>

    <a href="templates" class="mt-3 flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-blue-500 dark:border-gray-800 dark:bg-gray-900 dark:hover:bg-gray-800" data-testid="templates-link">
        <span class="min-w-0 flex-1">
            <span class="block font-semibold">@L["Templates.Heading"]</span>
            <span class="block text-sm text-gray-500 dark:text-gray-400">@L["Templates.Help"]</span>
        </span>
        <svg class="size-5 shrink-0 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </a>

    <a href="exercises" class="mt-3 flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-blue-500 dark:border-gray-800 dark:bg-gray-900 dark:hover:bg-gray-800" data-testid="exercises-link">
        <span class="min-w-0 flex-1">
            <span class="block font-semibold">@L["Exercises.Heading"]</span>
            <span class="block text-sm text-gray-500 dark:text-gray-400">@L["Exercises.Help"]</span>
        </span>
        <svg class="size-5 shrink-0 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </a>
}

@code {
    private UserSettings? settings;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            settings = await Repository.GetAsync<UserSettings>(UserSettings.SingletonId) ?? UserSettings.Default;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not read settings");
            settings = UserSettings.Default;
            error = L["Home.LoadFailed"];
        }
    }

    private async Task SaveAsync(UserSettings next)
    {
        var previous = settings;
        settings = next;
        error = null;
        try
        {
            await Repository.SaveAsync(UserSettings.SingletonId, next);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save settings");
            settings = previous;
            error = L["Home.SaveFailed"];
        }
    }
}
