@page "/templates/{Id:guid}"
@implements IDisposable
@inject LocalRepository Repository
@inject SyncEngine Engine
@inject NavigationManager Navigation
@inject ILogger<TemplatePage> Logger

<PageTitle>@L["App.Title"]</PageTitle>

<a href="templates" class="mb-1 inline-flex items-center gap-1 rounded-lg py-2 pr-2 text-sm text-blue-700 hover:underline dark:text-blue-300">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    @L["Templates.Heading"]
</a>

@if (!loaded)
{
    <p class="text-sm text-gray-500 dark:text-gray-400">@L["Common.Loading"]</p>
}
else if (template is null)
{
    <div class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-gray-300 px-4 py-10 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400" data-testid="not-found">
        <p>@L["Templates.NotFound"]</p>
    </div>
}
else
{
    <h1 class="sr-only">@template.Name</h1>
    <TextField Label="@L["Templates.Name"]" Value="@template.Name" Changed="RenameAsync" />

    @if (error is not null)
    {
        <p class="mt-3 text-sm text-red-600 dark:text-red-400" role="alert">@error</p>
    }

    <div class="mt-4">
        <ExerciseList Owner="AsWorkout(template)" Exercises="exercises" History="workouts" ForTemplate="true"
                      OnChange="edited => SaveAsync(WithEntries(edited))" OnExerciseChange="SaveExerciseAsync" />
    </div>

    <section class="mt-8 flex justify-end border-t border-gray-200 pt-4 dark:border-gray-800">
        @if (confirmingDelete)
        {
            <div class="flex items-center gap-2" role="alertdialog" aria-label="@L["Templates.DeleteConfirm"]">
                <span class="text-sm">@L["Templates.DeleteConfirm"]</span>
                <button type="button" @onclick="DeleteAsync" class="rounded-lg bg-red-600 px-4 py-2.5 font-medium text-white hover:bg-red-700">@L["Templates.Delete"]</button>
                <button type="button" @onclick="() => confirmingDelete = false" class="rounded-lg px-4 py-2.5 hover:bg-gray-100 dark:hover:bg-gray-800">@L["Common.Cancel"]</button>
            </div>
        }
        else
        {
            <button type="button" @onclick="() => confirmingDelete = true" class="rounded-lg px-4 py-2.5 font-medium text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950">
                @L["Templates.DeleteTemplate"]
            </button>
        }
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loaded;
    private WorkoutTemplate? template;
    private Dictionary<Guid, Exercise> exercises = [];
    private List<Workout> workouts = [];
    private bool confirmingDelete;
    private string? error;


    protected override async Task OnInitializedAsync()
    {
        Engine.DataChanged += OnRemoteChange;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            exercises = (await Repository.GetAllAsync<Exercise>()).ToDictionary(e => e.Id);
            workouts = [.. await Repository.GetAllAsync<Workout>()];
            template = await Repository.GetAsync<WorkoutTemplate>(Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not read template {Id}", Id);
            error = L["Home.LoadFailed"];
        }
        loaded = true;
    }

    // The editing helpers work on a workout's entry list; a template is the same list without results.
    private static Workout AsWorkout(WorkoutTemplate t) => new() { Id = t.Id, Date = DateOnly.MaxValue, Exercises = t.Exercises };

    private WorkoutTemplate WithEntries(Workout edited) => template! with { Exercises = edited.Exercises };

    private async Task SaveAsync(WorkoutTemplate next)
    {
        var previous = template;
        template = next;
        error = null;
        try
        {
            await Repository.SaveAsync(next.Id, next);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save template {Id}", next.Id);
            template = previous;
            error = L["Home.SaveFailed"];
        }
    }

    private Task RenameAsync(string? name) =>
        string.IsNullOrWhiteSpace(name) || template is null ? Task.CompletedTask : SaveAsync(template with { Name = name.Trim() });

    private async Task SaveExerciseAsync(Exercise exercise)
    {
        try
        {
            await Repository.SaveAsync(exercise.Id, exercise);
            exercises[exercise.Id] = exercise;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save exercise {Id}", exercise.Id);
            error = L["Home.SaveFailed"];
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            await Repository.DeleteAsync<WorkoutTemplate>(Id);
            Navigation.NavigateTo("templates");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not delete template");
            error = L["Home.SaveFailed"];
        }
    }

    private void OnRemoteChange() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Engine.DataChanged -= OnRemoteChange;
}
