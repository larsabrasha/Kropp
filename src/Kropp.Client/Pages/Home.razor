@page "/"
@implements IDisposable
@inject LocalRepository Repository
@inject SyncEngine Engine
@inject ILogger<Home> Logger

<PageTitle>@L["App.Title"]</PageTitle>

<h1 class="sr-only">@L["Home.Heading"]</h1>

<section class="rounded-xl border border-gray-200 p-4 dark:border-gray-800">
    <h2 class="mb-3 text-base font-semibold">@L["Home.NewWorkout"]</h2>
    <EditForm Model="form" OnValidSubmit="AddAsync" class="flex flex-col gap-3 sm:flex-row sm:items-end">
        <label class="flex flex-col gap-1 text-sm">
            <span>@L["Home.Date"]</span>
            <InputDate @bind-Value="form.Date" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-base dark:border-gray-700 dark:bg-gray-900" />
        </label>
        <label class="flex flex-1 flex-col gap-1 text-sm">
            <span>@L["Home.Note"]</span>
            <InputText @bind-Value="form.Note" maxlength="2000" placeholder="@L["Home.NotePlaceholder"]"
                       class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-base dark:border-gray-700 dark:bg-gray-900" />
        </label>
        <button type="submit" disabled="@saving"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 disabled:opacity-60">
            @if (saving)
            {
                <svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-dasharray="42 100" /></svg>
            }
            @L["Home.Add"]
        </button>
    </EditForm>
    @if (error is not null)
    {
        <p class="mt-3 text-sm text-red-600 dark:text-red-400" role="alert">@error</p>
    }
</section>

<section class="mt-6">
    <h2 class="mb-3 text-base font-semibold">@L["Home.Heading"]</h2>

    @if (workouts is null)
    {
        <p class="text-sm text-gray-500 dark:text-gray-400">@L["Common.Loading"]</p>
    }
    else if (workouts.Count == 0)
    {
        <div class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-gray-300 px-4 py-10 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400" data-testid="empty-state">
            <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11" />
            </svg>
            <p>@L["Home.Empty"]</p>
        </div>
    }
    else
    {
        <ul class="flex flex-col gap-2" data-testid="workout-list">
            @foreach (var workout in workouts)
            {
                <li @key="workout.Id" class="rounded-xl border border-gray-200 px-4 py-3 dark:border-gray-800">
                    <div class="flex items-baseline justify-between gap-3">
                        <span class="font-medium first-letter:uppercase">@workout.Date.ToString("dddd d MMMM yyyy")</span>
                        <span class="text-xs text-gray-500 dark:text-gray-400">@L[$"Workout.Status.{workout.Status}"]</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(workout.Note))
                    {
                        <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">@workout.Note</p>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    private sealed class NewWorkoutForm
    {
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Now);
        public string? Note { get; set; }
    }

    private NewWorkoutForm form = new();
    private List<Workout>? workouts;
    private bool saving;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Repository.Changed += OnDataChanged;
        Engine.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var all = await Repository.GetAllAsync<Workout>();
            workouts = [.. all.OrderByDescending(w => w.Date).ThenByDescending(w => w.SessionNumber)];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not read workouts");
            workouts = [];
            error = L["Home.LoadFailed"];
        }
    }

    private async Task AddAsync()
    {
        if (saving)
            return;
        saving = true;
        error = null;

        try
        {
            var workout = new Workout
            {
                Id = Guid.NewGuid(),
                Date = form.Date,
                Status = WorkoutStatus.Planned,
                Note = string.IsNullOrWhiteSpace(form.Note) ? null : form.Note.Trim(),
            };
            await Repository.SaveAsync(workout.Id, workout);
            form = new NewWorkoutForm { Date = form.Date };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save workout");
            error = L["Home.SaveFailed"];
        }
        finally
        {
            saving = false;
        }
    }

    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Repository.Changed -= OnDataChanged;
        Engine.DataChanged -= OnDataChanged;
    }
}
