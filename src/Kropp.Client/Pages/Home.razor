@page "/"
@implements IDisposable
@inject LocalRepository Repository
@inject SyncEngine Engine
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject ILogger<Home> Logger

<PageTitle>@L["App.Title"]</PageTitle>

<h1 class="sr-only">@L["Home.Heading"]</h1>

@* Colour follows priority: only the action (Planera/Öppna) is blue; the name reads first in
   weight, the day second; template choices and links stay neutral so they do not compete. *@
@* Two cards: what is next (green, when a plan exists) and planning (blue). Only their actions
   carry the accent colour; everything else in them stays neutral. *@
@if (workouts is null)
{
    <p class="text-sm text-gray-500 dark:text-gray-400">@L["Common.Loading"]</p>
}
else if (upcoming is not null)
{
    <section class="mb-3 rounded-xl border border-green-200 bg-green-50 p-4 dark:border-green-900 dark:bg-green-950/30" data-testid="next">
        <h2 class="mb-2 text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">@L["Next.Heading"]</h2>
        <a href="workouts/@upcoming.Id" class="flex items-center gap-3" data-testid="upcoming">
            <PlanIcon Slug="@ExerciseCategories.IconFor(upcoming, exercises)" />
            <span class="min-w-0 flex-1">
                <span class="block truncate text-lg font-semibold">@(ExerciseCategories.WorkoutName(upcoming, exercises, L) ?? L["Home.Heading"])</span>
                <span class="block text-sm text-gray-600 first-letter:uppercase dark:text-gray-300">@DayText(upcoming.Date)</span>
            </span>
            <span class="shrink-0 rounded-lg bg-green-600 px-4 py-2.5 font-medium text-white hover:bg-green-700">@L["Next.Open"]</span>
        </a>
    </section>
}

@if (workouts is not null)
{
<section class="rounded-xl border border-blue-200 bg-blue-50 p-4 dark:border-blue-900 dark:bg-blue-950/30" data-testid="plan-card">
    <h2 class="mb-2 text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">@(upcoming is null ? L["Next.PlanNext"] : L["Next.Another"])</h2>

    <div class="flex items-center gap-3">
        <PlanIcon Slug="@ExerciseCategories.IconFor(AsWorkout(chosen), exercises)" />
        <span class="min-w-0 flex-1">
            <span class="block truncate text-lg font-semibold text-gray-900 dark:text-gray-50" data-testid="next-name">@chosen.Name</span>
            @* The whole day is the date picker: a transparent input over the text, so tapping the day opens it. *@
            <label class="relative mt-0.5 inline-block cursor-pointer text-sm text-gray-600 underline decoration-gray-300 decoration-dotted underline-offset-4 dark:text-gray-300 dark:decoration-gray-600">
                <span class="first-letter:uppercase inline-block" data-testid="next-date">@DayText(planDate)</span>
                <input type="date" value="@planDate.ToString("yyyy-MM-dd")" @onchange="ChangePlanDate" aria-label="@L["Next.ChangeDay"]"
                       class="absolute inset-0 size-full cursor-pointer opacity-0" />
            </label>
        </span>
        <button type="button" @onclick="PlanAsync" disabled="@saving" data-testid="plan"
                class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-accent-600 px-4 py-2.5 font-medium text-white hover:bg-accent-700 disabled:opacity-60">
            @if (saving)
            {
                <svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-dasharray="42 100" /></svg>
            }
            @L["Next.Plan"]
        </button>
    </div>
    @if (templates.Count > 0)
    {
        <div class="mt-3 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]" role="radiogroup" aria-label="@L["Next.Templates"]" data-testid="template-choices">
            @* The chosen one is a deeper blue than the card with a border that holds 3:1 against it, never
               bolder: a bolder name is wider and moves the rest. *@
            @foreach (var template in templates.Append(EmptyTemplate))
            {
                var on = template.Id == chosen.Id;
                <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" @onclick="() => chosenId = template.Id" data-template="@(template.Id == Guid.Empty ? "empty" : template.Id)"
                        class="shrink-0 rounded-full border px-3 py-1.5 text-sm @(on ? "border-accent-600 bg-blue-200 text-blue-950 dark:border-blue-400 dark:bg-blue-900 dark:text-blue-50" : "border-gray-300 bg-white text-gray-700 hover:border-gray-500 dark:border-gray-600 dark:bg-gray-900 dark:text-gray-300")">
                    @template.Name
                </button>
            }
        </div>
    }
    @if (templates.Count == 0)
    {
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-300" data-testid="no-templates">@L["Next.NoTemplates"]</p>
    }

    @if (error is not null)
    {
        <p class="mt-3 text-sm text-red-600 dark:text-red-400" role="alert">@error</p>
    }
</section>
}

<section class="mt-6">
    <h2 class="mb-3 text-base font-semibold">@L["Home.Heading"]</h2>

    @if (workouts is null)
    {
        <p class="text-sm text-gray-500 dark:text-gray-400">@L["Common.Loading"]</p>
    }
    else if (workouts.Count == 0)
    {
        <div class="flex flex-col items-center gap-3 rounded-xl border border-dashed border-gray-300 px-4 py-10 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400" data-testid="empty-state">
            <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11" />
            </svg>
            <p>@L["Home.Empty"]</p>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-5" data-testid="workout-list">
            @foreach (var week in Weeks.Take(weeksShown))
            {
                <section @key="week.Key" data-testid="week">
                    <h3 class="mb-2 flex items-baseline gap-2 text-sm">
                        <span class="font-semibold">@L["Home.Week", week.Number]</span>
                        <span class="text-gray-500 dark:text-gray-400">@WeekRange(week.Monday)</span>
                    </h3>
                    <ul class="flex flex-col gap-2">
                        @foreach (var workout in week.Workouts)
                        {
                            var name = ExerciseCategories.WorkoutName(workout, exercises, L);
                            var icon = ExerciseCategories.IconFor(workout, exercises);
                            var status = WorkoutEditing.StatusOf(workout);
                            <li @key="workout.Id">
                                <a href="workouts/@workout.Id" class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white px-3 py-2.5 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-blue-500 dark:border-gray-800 dark:bg-gray-900 dark:hover:bg-gray-800">
                                    <span class="size-12 shrink-0 overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800" aria-hidden="true">
                                        @if (icon is not null)
                                        {
                                            <img src="@ExerciseIllustrations.Picture(icon)" alt="" class="illustration size-full object-contain p-1" data-testid="workout-icon" />
                                        }
                                    </span>
                                    <span class="min-w-0 flex-1">
                                        <span class="flex items-baseline justify-between gap-2">
                                            <span class="truncate font-semibold" data-testid="workout-name">@(name ?? workout.Note ?? L["Home.Heading"])</span>
                                            <StatusBadge Status="status" />
                                        </span>
                                        <span class="block truncate text-sm text-gray-500 dark:text-gray-400" data-testid="workout-meta">
                                            <span class="first-letter:uppercase inline-block">@workout.Date.ToString("dddd d MMM")</span>
                                            <span> · @(workout.Exercises.Count == 1 ? L["Home.ExerciseCountOne"] : L["Home.ExerciseCount", workout.Exercises.Count])</span>
                                            @if (name is not null && !string.IsNullOrWhiteSpace(workout.Note))
                                            {
                                                <span> · @workout.Note</span>
                                            }
                                        </span>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (Weeks.Count > weeksShown)
            {
                <button type="button" @onclick="() => weeksShown += WeeksPerPage" data-testid="more-weeks"
                        class="rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800">
                    @L["Home.MoreWeeks", Weeks.Count - weeksShown]
                </button>
            }
        </div>
    }
</section>

@code {


    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
    private List<Workout>? workouts;
    private Dictionary<Guid, Exercise> exercises = [];
    private List<WorkoutTemplate> templates = [];
    private Workout? upcoming;
    private Guid? chosenId;
    private DateOnly planDate;

    // An empty workout is offered as one more choice, last, with no exercises; it is never the suggestion
    // unless there are no templates at all.
    private WorkoutTemplate EmptyTemplate => new() { Id = Guid.Empty, Name = L["Next.Empty"] };

    // The chosen template, or the suggested one until another is tapped.
    private WorkoutTemplate chosen => chosenId == Guid.Empty ? EmptyTemplate
        : templates.FirstOrDefault(t => t.Id == chosenId)
          ?? Planning.SuggestTemplate(templates, workouts ?? [], id => exercises.GetValueOrDefault(id), Today)
          ?? EmptyTemplate;
    private bool saving;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Repository.Changed += OnDataChanged;
        Engine.DataChanged += OnDataChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var all = await Repository.GetAllAsync<Workout>();
            exercises = (await Repository.GetAllAsync<Exercise>()).ToDictionary(e => e.Id);
            workouts = [.. all.OrderByDescending(w => w.Date).ThenByDescending(w => w.SessionNumber)];
            templates = [.. (await Repository.GetAllAsync<WorkoutTemplate>()).OrderBy(t => t.Name, StringComparer.CurrentCultureIgnoreCase)];
            upcoming = Planning.Upcoming(all, Today);
            var settings = await Repository.GetAsync<UserSettings>(UserSettings.SingletonId) ?? UserSettings.Default;
            planDate = upcoming is null ? Planning.SuggestDate(all, Today, settings) : Planning.SuggestDateAfter(upcoming, all, Today, settings);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not read workouts");
            workouts = [];
            error = L["Home.LoadFailed"];
        }
    }

    private async Task PlanAsync()
    {
        if (saving)
            return;
        var template = chosen;
        saving = true;
        error = null;
        try
        {
            var plan = Planning.PlanFrom(template, Guid.NewGuid(), planDate, WorkoutEditing.NextSessionNumber(workouts ?? []), workouts ?? []);
            if (template.Id == Guid.Empty)
                plan = plan with { TemplateId = null };
            plan = WorkoutEditing.WithDerivedStatus(plan);
            await Repository.SaveAsync(plan.Id, plan);
            Navigation.NavigateTo($"workouts/{plan.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not plan from template");
            error = L["Home.SaveFailed"];
        }
        finally
        {
            saving = false;
        }
    }

    private void ChangePlanDate(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", out var date))
            planDate = date;
    }

    private string DayText(DateOnly date) =>
        date == Today ? L["Next.Today"] : date == Today.AddDays(1) ? L["Next.Tomorrow", date.ToString("d MMM")] : date.ToString("dddd d MMM");

    private static Workout AsWorkout(WorkoutTemplate template) =>
        new() { Id = template.Id, Date = default, Exercises = template.Exercises };

    // The list opens with the latest weeks; older ones are a tap away. All of it is local already,
    // so this only keeps the page short.
    private const int WeeksPerPage = 4;
    private int weeksShown = WeeksPerPage;

    private sealed record Week(string Key, int Number, DateOnly Monday, List<Workout> Workouts);

    // Weeks run Monday to Sunday and are numbered by ISO 8601, as Swedish calendars are.
    private List<Week> Weeks => [.. (workouts ?? [])
        .GroupBy(w => Planning.MondayOf(w.Date))
        .OrderByDescending(g => g.Key)
        .Select(g => new Week(g.Key.ToString("yyyy-MM-dd"), Planning.WeekNumber(g.Key), g.Key, [.. g]))];

    private static string WeekRange(DateOnly monday)
    {
        var sunday = monday.AddDays(6);
        return monday.Month == sunday.Month
            ? $"{monday.Day}–{sunday.Day} {sunday:MMMM}"
            : $"{monday:d MMM} – {sunday:d MMM}";
    }

    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Repository.Changed -= OnDataChanged;
        Engine.DataChanged -= OnDataChanged;
    }
}
