@inherits LayoutComponentBase

<div class="min-h-dvh bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <header class="sticky top-0 z-10 border-b border-gray-200 bg-white/90 pt-[env(safe-area-inset-top)] backdrop-blur dark:border-gray-800 dark:bg-gray-950/90">
        <div class="mx-auto flex max-w-2xl items-center justify-between gap-4 px-4 py-3">
            <span class="text-lg font-semibold">@L["App.Title"]</span>
            <SyncStatusBar />
        </div>
    </header>
    <main class="mx-auto max-w-2xl px-4 pb-[calc(2rem+env(safe-area-inset-bottom))] pt-4">
        @Body
    </main>
</div>
