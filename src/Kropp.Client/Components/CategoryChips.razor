@* The six body areas as toggles. The last selected one cannot be turned off, since an exercise
   always has at least one. *@

<div class="flex flex-wrap gap-2" role="group" aria-label="@L["Entry.Categories"]" data-testid="category-chips">
    @foreach (var area in Enum.GetValues<BodyArea>())
    {
        var on = Selected.Contains(area);
        <button type="button" aria-pressed="@(on ? "true" : "false")" data-area="@area"
                disabled="@(on && Selected.Count == 1)" @onclick="() => Toggle(area)"
                class="min-h-10 rounded-full px-4 text-sm font-medium disabled:cursor-not-allowed @(on ? "bg-accent-600 text-white" : "border border-gray-300 text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800")">
            @L[$"BodyArea.{area}"]
        </button>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<BodyArea> Selected { get; set; } = [];
    [Parameter] public EventCallback<List<BodyArea>> Changed { get; set; }

    private Task Toggle(BodyArea area)
    {
        var next = Selected.Contains(area) ? Selected.Where(a => a != area) : Selected.Append(area);
        return Changed.InvokeAsync([.. next.Distinct().Order()]);
    }
}
