@* A number with large − and + buttons, for adjusting reps and weight with a thumb. The label sits
   above, as on every field. The number starts at the left like any field's text, and the field is
   only as wide as a weight needs; the buttons follow it, with room between them so a thumb takes
   the one it means. The field is still a field, for typing an exact value. Values
   never go below zero. *@

<div class="flex flex-col gap-1" data-testid="stepper" data-label="@Label">
    <span class="pl-inset text-xs text-gray-600 dark:text-gray-400">@Label</span>
    <div class="flex items-center gap-2">
        <input type="number" inputmode="decimal" min="@TrainingText.Invariant(Min)" max="@TrainingText.Invariant(Max)" step="@TrainingText.Invariant(Step)" value="@TrainingText.Invariant(Value)" aria-label="@Label"
               @onchange="e => Changed.InvokeAsync(Clamp(TrainingText.ParseDecimal(e.Value)))"
               class="h-11 w-full min-w-0 max-w-32 rounded-xl border border-gray-300 bg-white px-3 text-left text-lg font-semibold tabular-nums text-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100" />
        <div class="flex shrink-0 gap-3">
            <button type="button" @onclick="() => Change(-Step)" disabled="@(Value is null || Value <= Min)"
                    aria-label="@L["Stepper.Decrease", Label]" title="@L["Stepper.Decrease", Label]" data-testid="decrease"
                    class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-gray-200 text-2xl font-medium text-gray-800 hover:bg-gray-300 active:bg-gray-400 disabled:opacity-40 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700">
                −
            </button>
            <button type="button" @onclick="() => Change(Step)" disabled="@(Max is { } max && Value >= max)"
                    aria-label="@L["Stepper.Increase", Label]" title="@L["Stepper.Increase", Label]" data-testid="increase"
                    class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-gray-200 text-2xl font-medium text-gray-800 hover:bg-gray-300 active:bg-gray-400 disabled:opacity-40 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700">
                +
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public decimal Step { get; set; } = 1;
    [Parameter] public EventCallback<decimal?> Changed { get; set; }

    /// <summary>The highest value + goes to.</summary>
    [Parameter] public decimal? Max { get; set; }

    /// <summary>The lowest value − goes to.</summary>
    [Parameter] public decimal Min { get; set; }

    /// <summary>What + gives an empty field, where one step from zero is no use (a pulse of 1).</summary>
    [Parameter] public decimal? Start { get; set; }

    /// <summary>A typed value kept within <see cref="Min"/> and <see cref="Max"/>, as − and + keep it.</summary>
    private decimal? Clamp(decimal? value) =>
        value is not { } v ? null : Math.Clamp(v, Min, Max ?? decimal.MaxValue);

    private Task Change(decimal delta)
    {
        if (Value is null && delta > 0 && Start is { } start)
            return Changed.InvokeAsync(start);

        // A step lands on the step's grid, so 21 + 2.5 is 22.5 rather than 23.5 after a typed value.
        var current = Value ?? 0;
        var next = delta > 0
            ? Math.Floor(current / Step) * Step + Step
            : Math.Ceiling(current / Step) * Step - Step;
        next = Math.Max(Min, Math.Round(next, 2));
        if (Max is { } max)
            next = Math.Min(max, next);
        return Changed.InvokeAsync(next);
    }
}
