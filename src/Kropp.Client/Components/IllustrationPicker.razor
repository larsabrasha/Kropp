@* Every illustration, searchable by its English name, with "no picture" first. Thumbnails load
   lazily, so opening the picker fetches only what scrolls into view. The pictures' credit is
   shown here, where they are chosen, and not wherever one is shown. *@

<div data-testid="illustration-picker">
    <input type="search" value="@query" maxlength="@Limits.Search" @oninput="e => query = e.Value?.ToString() ?? string.Empty"
           placeholder="@L["Illustration.Search"]" aria-label="@L["Illustration.Search"]" autocomplete="off"
           class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-base dark:border-gray-700 dark:bg-gray-900" />
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">@L["Illustration.Count", Matches.Count]</p>
    <div class="mt-2 grid max-h-80 grid-cols-4 gap-2 overflow-y-auto sm:grid-cols-6">
        <button type="button" @onclick="() => OnPick.InvokeAsync(Exercise.NoIllustration)"
                class="flex aspect-square items-center justify-center rounded-lg border border-dashed border-gray-300 p-1 text-center text-xs text-gray-500 dark:border-gray-700 dark:text-gray-400 @(Selected is null ? "ring-2 ring-blue-500" : "")">
            @L["Illustration.None"]
        </button>
        @foreach (var (slug, name) in Matches)
        {
            <button type="button" @key="slug" @onclick="() => OnPick.InvokeAsync(slug)" title="@name" aria-label="@name" data-slug="@slug"
                    class="aspect-square rounded-lg bg-gray-100 p-1 dark:bg-gray-800 @(Selected == slug ? "ring-2 ring-blue-500" : "")">
                <img src="@ExerciseIllustrations.Picture(slug)" alt="" loading="lazy" class="illustration size-full object-contain" />
            </button>
        }
    </div>
    <p class="mt-2 text-[11px] leading-tight text-gray-400 dark:text-gray-500" data-testid="illustration-credit">
        @L["Illustration.Credit"] <a href="https://github.com/bryllim/workout-guide" target="_blank" rel="noopener" class="underline">Bryl Lim</a>, <a href="https://github.com/everkinetic/data" target="_blank" rel="noopener" class="underline">Everkinetic</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener" class="underline">CC BY-SA 4.0</a>
    </p>
</div>

@code {
    [Parameter] public string? Selected { get; set; }
    [Parameter] public EventCallback<string> OnPick { get; set; }

    private string query = string.Empty;

    private List<(string Slug, string Name)> Matches => [.. ExerciseIllustrations.Catalog
        .Where(kv => kv.Value.Name.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase) || kv.Key.Contains(query.Trim().Replace(' ', '-'), StringComparison.OrdinalIgnoreCase))
        .OrderBy(kv => kv.Value.Name, StringComparer.OrdinalIgnoreCase)
        .Select(kv => (kv.Key, kv.Value.Name))];
}
