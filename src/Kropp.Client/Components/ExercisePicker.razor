<div class="rounded-xl border border-blue-300 p-4 dark:border-blue-800" data-testid="exercise-picker">
    <label class="flex flex-col gap-1 text-sm">
        <span>@L["Picker.Search"]</span>
        <input type="search" value="@query" @oninput="e => query = e.Value?.ToString() ?? string.Empty" @ref="searchInput"
               autocomplete="off" maxlength="200" placeholder="@L["Picker.SearchPlaceholder"]"
               class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-base dark:border-gray-700 dark:bg-gray-900" />
    </label>

    <ul class="mt-3 flex max-h-72 flex-col gap-1 overflow-y-auto">
        @foreach (var exercise in Matches)
        {
            var slug = ExerciseIllustrations.SlugFor(exercise);
            <li @key="exercise.Id">
                <button type="button" @onclick="() => OnPick.InvokeAsync(exercise)"
                        class="flex w-full items-center gap-3 rounded-lg px-2 py-1.5 text-left hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-blue-500 dark:hover:bg-gray-800">
                    <span class="size-10 shrink-0 overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800" aria-hidden="true">
                        @if (slug is not null)
                        {
                            <img src="@ExerciseIllustrations.Picture(slug)" alt="" loading="lazy" class="illustration size-full object-contain p-0.5" data-testid="picker-thumbnail" />
                        }
                    </span>
                    <span class="min-w-0 flex-1 truncate">@exercise.Name</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">@L[$"Exercise.Kind.{exercise.Kind}"]</span>
                </button>
            </li>
        }
    </ul>

    @if (Matches.Count == 0 && string.IsNullOrWhiteSpace(query))
    {
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">@L["Picker.NoExercises"]</p>
    }

    @if (!string.IsNullOrWhiteSpace(query) && !ExactMatch)
    {
        <div class="mt-3 flex flex-col gap-2 border-t border-gray-200 pt-3 sm:flex-row sm:items-end dark:border-gray-800">
            <label class="flex flex-col gap-1 text-sm">
                <span>@L["Picker.Kind"]</span>
                <select @bind="newKind" class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-base dark:border-gray-700 dark:bg-gray-900">
                    @foreach (var kind in Enum.GetValues<ExerciseKind>())
                    {
                        <option value="@kind">@L[$"Exercise.Kind.{kind}"]</option>
                    }
                </select>
            </label>
            <button type="button" @onclick="CreateAsync" data-testid="create-exercise"
                    class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
                @L["Picker.Create", query.Trim()]
            </button>
        </div>
    }

    <div class="mt-3 flex justify-end">
        <button type="button" @onclick="OnCancel" class="rounded-lg px-4 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-800">@L["Common.Cancel"]</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Exercise> Exercises { get; set; } = [];
    [Parameter] public EventCallback<Exercise> OnPick { get; set; }
    [Parameter] public EventCallback<(string Name, ExerciseKind Kind)> OnCreate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string query = string.Empty;
    private ExerciseKind newKind = ExerciseKind.Strength;
    private ElementReference searchInput;

    private List<Exercise> Matches => [.. Exercises
        .Where(e => !e.IsArchived && e.Name.Contains(query.Trim(), StringComparison.CurrentCultureIgnoreCase))
        .OrderBy(e => e.Name, StringComparer.CurrentCultureIgnoreCase)];

    private bool ExactMatch => Exercises.Any(e => string.Equals(e.Name.Trim(), query.Trim(), StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await searchInput.FocusAsync(); }
            catch (InvalidOperationException) { /* not attached, as in tests */ }
        }
    }

    private Task CreateAsync() => OnCreate.InvokeAsync((query.Trim(), newKind));
}
