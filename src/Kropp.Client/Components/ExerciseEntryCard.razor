@* Compact by default: the name and plan on one line, the set buttons, one grey line of context.
   Everything else opens in place on a tap and closes with Klar. At the gym, with a plan that
   was right, the set buttons are all that gets touched — so they stay large and always first. *@

<article class="rounded-xl border border-gray-200 p-3 dark:border-gray-800" data-testid="exercise-entry">
    <div class="flex items-center gap-1">
        <span class="drag-handle -my-1 -ml-1 flex shrink-0 cursor-grab touch-none items-center self-stretch px-1 text-gray-300 active:cursor-grabbing dark:text-gray-600"
              title="@L["Entry.Drag"]" aria-hidden="true" data-testid="drag-handle">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.5" /><circle cx="15" cy="6" r="1.5" /><circle cx="9" cy="12" r="1.5" /><circle cx="15" cy="12" r="1.5" /><circle cx="9" cy="18" r="1.5" /><circle cx="15" cy="18" r="1.5" /></svg>
        </span>
        <button type="button" @onclick="() => Toggle(Panel.Illustration)" aria-expanded="@Expanded(Panel.Illustration)"
                aria-label="@L["Illustration.Show", Exercise?.Name ?? ""]" title="@L["Illustration.Show", Exercise?.Name ?? ""]" data-testid="thumbnail"
                class="size-10 shrink-0 overflow-hidden rounded-lg @(Slug is null ? "border border-dashed border-gray-300 text-gray-400 dark:border-gray-700" : "bg-gray-100 dark:bg-gray-800")">
            @if (Slug is not null)
            {
                <img src="@ExerciseIllustrations.Picture(Slug)" alt="" class="illustration size-full object-contain p-0.5" />
            }
            else
            {
                <svg class="m-auto size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M4 16l4-4 4 4 3-3 5 5" /></svg>
            }
        </button>
        <h3 class="min-w-0 flex-1 truncate font-semibold">@(Exercise?.Name ?? L["Exercise.Unknown"])</h3>
        <button type="button" @onclick="() => Toggle(Panel.Targets)" aria-expanded="@Expanded(Panel.Targets)" data-testid="target"
                class="shrink-0 rounded-lg px-2 py-1.5 text-sm tabular-nums text-gray-700 underline decoration-gray-300 decoration-dotted underline-offset-4 hover:bg-gray-100 dark:text-gray-300 dark:decoration-gray-600 dark:hover:bg-gray-800">
            @TargetText
        </button>
        <button type="button" @onclick="() => Toggle(Panel.Menu)" aria-expanded="@Expanded(Panel.Menu)" aria-label="@L["Entry.More"]" title="@L["Entry.More"]" data-testid="more"
                class="shrink-0 rounded-lg p-2 text-gray-600 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-blue-500 dark:text-gray-400 dark:hover:bg-gray-800">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="19" cy="12" r="1.8" /></svg>
        </button>
    </div>

    @if (panel == Panel.Menu)
    {
        <div class="mt-2 flex flex-wrap gap-1" data-testid="menu">
            <MenuButton OnClick="() => Toggle(Panel.Notes)">@L["Entry.EditNotes"]</MenuButton>
            <MenuButton OnClick="() => Toggle(Panel.Categories)">@L["Entry.Categories"]</MenuButton>
            <MenuButton OnClick="OnRemove" Danger="true">@L["Entry.Remove"]</MenuButton>
        </div>
    }

    @if (panel == Panel.Categories && Exercise is not null)
    {
        <div class="mt-2 rounded-lg bg-gray-50 p-2 dark:bg-gray-900" data-testid="categories-editor">
            <CategoryChips Selected="ExerciseCategories.For(Exercise)" Changed="areas => OnExerciseChange.InvokeAsync(Exercise with { Categories = areas })" />
            <DoneRow OnDone="Close" />
        </div>
    }

    @if (panel == Panel.Illustration)
    {
        <div class="mt-2 rounded-lg bg-gray-50 p-2 dark:bg-gray-900" data-testid="illustration">
            @if (choosingIllustration || Slug is null)
            {
                <IllustrationPicker Selected="Slug" OnPick="PickIllustration" />
            }
            else
            {
                <div class="mx-auto aspect-square w-full max-w-64 rounded-lg bg-gray-100 p-2 dark:bg-gray-800" data-testid="illustration-large">
                    <img src="@ExerciseIllustrations.Picture(Slug)" alt="@ExerciseIllustrations.NameOf(Slug)" class="illustration size-full object-contain" />
                </div>
                <p class="mt-1 text-center text-xs text-gray-500 dark:text-gray-400">@ExerciseIllustrations.NameOf(Slug)</p>
            }
            <p class="mt-2 text-[11px] leading-tight text-gray-400 dark:text-gray-500">
                @L["Illustration.Credit"] <a href="https://github.com/bryllim/workout-guide" target="_blank" rel="noopener" class="underline">Bryl Lim</a>, <a href="https://github.com/everkinetic/data" target="_blank" rel="noopener" class="underline">Everkinetic</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener" class="underline">CC BY-SA 4.0</a>
            </p>
            <DoneRow OnDone="Close">
                @if (!choosingIllustration && Slug is not null)
                {
                    <button type="button" @onclick="() => choosingIllustration = true" class="rounded-lg px-3 py-2 text-sm hover:bg-gray-200 dark:hover:bg-gray-800" data-testid="change-illustration">@L["Illustration.Change"]</button>
                }
            </DoneRow>
        </div>
    }

    @if (panel == Panel.Targets)
    {
        <div class="mt-2 rounded-lg bg-gray-50 p-2 dark:bg-gray-900" data-testid="target-editor">
            <div class="flex flex-col gap-2">
                @if (Kind == ExerciseKind.Cardio)
                {
                    <Stepper Label="@L["Entry.Minutes"]" Value="Entry.DurationMinutes" Step="0.5m" Start="5" Changed="v => Change(Entry with { DurationMinutes = v })" />
                    <Stepper Label="@L["Entry.Km"]" Value="Entry.DistanceKm" Step="0.1m" Start="1" Changed="v => Change(Entry with { DistanceKm = v })" />
                    <Stepper Label="@L["Entry.Pulse"]" Value="Entry.AvgHeartRate" Start="120" Changed="v => Change(Entry with { AvgHeartRate = ToInt(v) })" />
                }
                else
                {
                    <Stepper Label="@L["Entry.Sets"]" Value="Entry.TargetSets" Changed="v => Change(Entry with { TargetSets = ToInt(v) })" />
                    @if (Kind == ExerciseKind.Timed)
                    {
                        <Stepper Label="@L["Entry.Seconds"]" Value="Entry.TargetSeconds" Step="5" Changed="v => Change(Entry with { TargetSeconds = ToInt(v) })" />
                    }
                    else
                    {
                        <Stepper Label="@L["Entry.Reps"]" Value="Entry.TargetReps" Changed="v => Change(Entry with { TargetReps = ToInt(v) })" />
                    }
                    @if (Kind == ExerciseKind.Strength)
                    {
                        <Stepper Label="@L["Entry.Kg"]" Value="Entry.TargetWeightKg" Step="WeightStep" Changed="v => Change(Entry with { TargetWeightKg = v })" />
                        <label class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                            <span class="w-20 shrink-0">@L["Entry.WeightStep"]</span>
                            <select value="@TrainingText.Invariant(WeightStep)" @onchange="ChangeWeightStep" data-testid="weight-step"
                                    class="rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-base text-gray-900 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">
                                @foreach (var step in Exercise.WeightSteps)
                                {
                                    <option value="@TrainingText.Invariant(step)">@TrainingText.Number(step) kg</option>
                                }
                            </select>
                        </label>
                    }
                }
            </div>
            <DoneRow OnDone="Close" />
        </div>
    }

    @if (Kind != ExerciseKind.Cardio)
    {
        <div class="mt-2 flex gap-2" data-testid="sets">
            @for (var i = 0; i < PlannedSlots; i++)
            {
                var index = i;
                if (index < Entry.Sets.Count)
                {
                    var set = Entry.Sets[index];
                    var weight = TrainingText.SetWeightIfChanged(set, Entry, Kind);
                    var shortSet = TrainingText.IsShort(set, Entry, Kind);
                    <button type="button" @onclick="() => Toggle(Panel.Set, index)" aria-expanded="@Expanded(Panel.Set, index)"
                            aria-label="@L["Entry.SetDone", index + 1, TrainingText.Set(set, Kind)]"
                            class="relative inline-flex min-h-14 min-w-0 flex-1 flex-col items-center justify-center whitespace-nowrap rounded-xl px-1 tabular-nums focus-visible:outline-2 focus-visible:outline-offset-2 @(shortSet ? "bg-amber-300 text-gray-900 hover:bg-amber-400 focus-visible:outline-amber-500" : "bg-green-600 text-white hover:bg-green-700 focus-visible:outline-green-500")"
                            data-testid="set-done" data-short="@(shortSet ? "true" : "false")">
                        <svg class="absolute left-1.5 top-1.5 size-3 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                        <span class="text-xl font-semibold leading-tight">@TrainingText.SetMain(set, Kind)</span>
                        @if (weight is not null)
                        {
                            <span class="text-xs font-medium leading-tight opacity-90" data-testid="set-weight">@weight</span>
                        }
                    </button>
                }
                else if (index == Entry.Sets.Count)
                {
                    <button type="button" @onclick="CompleteNext"
                            class="inline-flex min-h-14 min-w-0 flex-1 items-center justify-center rounded-xl border-2 border-blue-600 px-1 text-base font-semibold text-blue-700 hover:bg-blue-50 active:bg-blue-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 dark:text-blue-300 dark:hover:bg-blue-950"
                            data-testid="set-next">
                        @L["Entry.SetN", index + 1]
                    </button>
                }
                else
                {
                    <span class="inline-flex min-h-14 min-w-0 flex-1 items-center justify-center rounded-xl border border-dashed border-gray-300 px-1 text-gray-400 dark:border-gray-700">@L["Entry.SetN", index + 1]</span>
                }
            }
            @if (Entry.Sets.Count >= PlannedSlots)
            {
                <button type="button" @onclick="CompleteNext" aria-label="@L["Entry.ExtraSet"]" title="@L["Entry.ExtraSet"]" data-testid="set-extra"
                        class="inline-flex min-h-14 w-11 shrink-0 items-center justify-center rounded-xl border border-gray-300 text-xl text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800">
                    +
                </button>
            }
        </div>

        @if (panel == Panel.Set && setIndex < Entry.Sets.Count)
        {
            var e = setIndex;
            var set = Entry.Sets[e];
            <div class="mt-2 rounded-lg bg-gray-50 p-2 dark:bg-gray-900" data-testid="set-editor">
                <div class="flex flex-col gap-2">
                    @if (Kind == ExerciseKind.Timed)
                    {
                        <Stepper Label="@L["Entry.Seconds"]" Value="set.Seconds" Step="5" Changed="v => Change(WorkoutEditing.ReplaceSet(Entry, e, set with { Seconds = ToInt(v) }))" />
                    }
                    else
                    {
                        <Stepper Label="@L["Entry.Reps"]" Value="set.Reps" Changed="v => Change(WorkoutEditing.ReplaceSet(Entry, e, set with { Reps = ToInt(v) }))" />
                    }
                    @if (Kind == ExerciseKind.Strength)
                    {
                        <Stepper Label="@L["Entry.Kg"]" Value="set.WeightKg" Step="WeightStep" Changed="v => Change(WorkoutEditing.ReplaceSet(Entry, e, set with { WeightKg = v }))" />
                    }
                </div>
                <DoneRow OnDone="Close">
                    <button type="button" @onclick="() => RemoveSet(e)" class="rounded-lg px-3 py-2 text-sm text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950">@L["Entry.RemoveSet"]</button>
                </DoneRow>
            </div>
        }
    }

    @if (panel == Panel.Notes)
    {
        <div class="mt-2 rounded-lg bg-gray-50 p-2 dark:bg-gray-900" data-testid="notes-editor">
            <div class="grid gap-2 sm:grid-cols-2">
                <TextField Label="@L["Entry.Settings"]" Value="@Entry.Settings" Placeholder="@L["Entry.SettingsPlaceholder"]" Changed="v => Change(Entry with { Settings = v })" />
                <TextField Label="@L["Entry.Comment"]" Value="@Entry.Comment" Placeholder="@L["Entry.CommentPlaceholder"]" Changed="v => Change(Entry with { Comment = v })" />
            </div>
            <DoneRow OnDone="Close" />
        </div>
    }
    else if (ContextParts.Count > 0)
    {
        <button type="button" @onclick="() => Toggle(Panel.Notes)" data-testid="context"
                class="mt-2 block w-full truncate rounded-md text-left text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
            @string.Join(" · ", ContextParts)
        </button>
    }
</article>

@code {
    public enum Panel { None, Targets, Menu, Notes, Set, Illustration, Categories }

    [Parameter, EditorRequired] public WorkoutExercise Entry { get; set; } = default!;
    [Parameter] public Exercise? Exercise { get; set; }
    [Parameter] public WorkoutExercise? LastTime { get; set; }

    /// <summary>Whether this card may show an open panel; the page lets one card at a time.</summary>
    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback OnActivate { get; set; }
    [Parameter] public EventCallback<WorkoutExercise> OnChange { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    /// <summary>Raised with the exercise changed in the register, such as a new picture.</summary>
    [Parameter] public EventCallback<Exercise> OnExerciseChange { get; set; }

    private Panel openPanel;
    private bool choosingIllustration;

    private string? Slug => ExerciseIllustrations.SlugFor(Exercise);

    private decimal WeightStep => Exercise?.WeightStepKg ?? Exercise.DefaultWeightStepKg;

    private static int? ToInt(decimal? value) => value is { } v ? (int)Math.Round(v) : null;

    private async Task ChangeWeightStep(ChangeEventArgs e)
    {
        if (Exercise is not null && TrainingText.ParseDecimal(e.Value) is { } step && Exercise.WeightSteps.Contains(step))
            await OnExerciseChange.InvokeAsync(Exercise with { WeightStepKg = step == Exercise.DefaultWeightStepKg ? null : step });
    }
    private int setIndex;

    private Panel panel => Active ? openPanel : Panel.None;

    private ExerciseKind Kind => Exercise?.Kind ?? ExerciseKind.Strength;

    private int PlannedSlots => Math.Max(Entry.TargetSets ?? 0, Entry.Sets.Count);

    private string TargetText
    {
        get
        {
            var text = TrainingText.Target(Entry, Kind);
            if (Kind == ExerciseKind.Cardio && !string.IsNullOrWhiteSpace(Entry.Settings))
                text = string.IsNullOrEmpty(text) ? Entry.Settings : $"{text} · {Entry.Settings}";
            return string.IsNullOrWhiteSpace(text) ? L["Entry.SetTarget"] : text;
        }
    }

    private List<string> ContextParts
    {
        get
        {
            var parts = new List<string>();
            if (LastTime is not null)
                parts.Add(L["Entry.LastTime", TrainingText.Result(LastTime, Kind)]);
            if (!string.IsNullOrWhiteSpace(Exercise?.SettingsNote))
                parts.Add(Exercise.SettingsNote);
            if (Kind != ExerciseKind.Cardio && !string.IsNullOrWhiteSpace(Entry.Settings))
                parts.Add(Entry.Settings);
            if (!string.IsNullOrWhiteSpace(Entry.Comment))
                parts.Add($"”{Entry.Comment}”");
            return parts;
        }
    }

    private string Expanded(Panel p, int index = 0) => panel == p && (p != Panel.Set || setIndex == index) ? "true" : "false";

    private async Task Toggle(Panel p, int index = 0)
    {
        var isOpen = panel == p && (p != Panel.Set || setIndex == index);
        openPanel = isOpen ? Panel.None : p;
        choosingIllustration = false;
        setIndex = index;
        if (!isOpen)
            await OnActivate.InvokeAsync();
    }

    private void Close()
    {
        openPanel = Panel.None;
        choosingIllustration = false;
    }

    private async Task PickIllustration(string slug)
    {
        choosingIllustration = false;
        if (Exercise is not null)
            await OnExerciseChange.InvokeAsync(Exercise with { Illustration = slug });
    }

    private Task Change(WorkoutExercise next) => OnChange.InvokeAsync(next);

    private Task CompleteNext()
    {
        openPanel = Panel.None;
        return Change(WorkoutEditing.CompleteNextSet(Entry, Kind));
    }

    private Task RemoveSet(int index)
    {
        openPanel = Panel.None;
        return Change(WorkoutEditing.RemoveSet(Entry, index));
    }
}
