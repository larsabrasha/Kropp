<button type="button" @onclick="OnClick" disabled="@Disabled"
        class="rounded-lg border px-3 py-2 text-sm disabled:opacity-40 @(Danger ? "border-red-200 text-red-700 hover:bg-red-50 dark:border-red-900 dark:text-red-400 dark:hover:bg-red-950" : "border-gray-200 hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800")">
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Danger { get; set; }
}
