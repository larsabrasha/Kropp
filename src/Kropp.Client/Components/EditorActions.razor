@* The last row of an editor on a card: delete far left, done far right. Symbol and word both, so
   a delete is never taken for something else. *@

<div class="flex items-center gap-2">
    @if (OnDelete.HasDelegate)
    {
        <button type="button" @onclick="OnDelete" data-testid="@DeleteTestId"
                class="flex min-h-11 items-center gap-1.5 rounded-lg px-3 text-sm font-medium text-red-700 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-red-500 dark:text-red-400 dark:hover:bg-red-950">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3" /></svg>
            @DeleteLabel
        </button>
    }
    <button type="button" @onclick="OnDone" data-testid="close-editor"
            class="ml-auto flex min-h-11 items-center gap-1.5 rounded-lg px-4 text-sm font-medium bg-gray-200 text-gray-800 hover:bg-gray-300 focus-visible:outline-2 focus-visible:outline-blue-500 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
        @L["Common.Done"]
    </button>
</div>

@code {
    [Parameter] public EventCallback OnDone { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public string? DeleteLabel { get; set; }
    [Parameter] public string? DeleteTestId { get; set; }
}
