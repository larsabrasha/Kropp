<div class="mt-2 flex items-center justify-end gap-2">
    @ChildContent
    <button type="button" @onclick="OnDone" class="rounded-lg bg-gray-200 px-4 py-2 text-sm font-medium hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700">@L["Common.Done"]</button>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnDone { get; set; }
}
